{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COON",
  "version": "0.1.0",
  "identifier": "dev.coon.desktop",
  "build": {
    "frontendDist": "../web/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "COON — Call Graph",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "C/C++ call graph visualizer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
